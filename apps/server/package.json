{
  "name": "@perspice/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations && rm -rf dist/email/templates && cp -r src/email/templates dist/email/templates",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
