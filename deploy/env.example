# Perspice IoT — environment for docker-compose.yml.
# install.sh generates this file (mode 600) with random secrets; edit and run
# `perspice restart` to apply changes.

# --- Release ---------------------------------------------------------------
PERSPICE_VERSION=0.1.0
PERSPICE_IMAGE_OWNER=perspice

# --- Domain -----------------------------------------------------------------
# Platform UI on BASE_DOMAIN, customers on <slug>.BASE_DOMAIN, MQTT on mqtt.BASE_DOMAIN.
BASE_DOMAIN=localhost
PUBLIC_URL=https://localhost
# Contact address for Let's Encrypt certificate notices (required).
ACME_EMAIL=you@yourcompany.com

# --- Secrets (generate with: openssl rand -base64 32) -----------------------
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-characters-long
# 32 random bytes, base64. Encrypts stored secrets; losing it makes them unreadable.
MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INTERNAL_SECRET=change-me
MQTT_INGEST_PASSWORD=change-me
EMQX_API_KEY=perspice
EMQX_API_SECRET=change-me
EMQX_DASHBOARD_PASSWORD=change-me

# --- MQTT ------------------------------------------------------------------
# Plain (non-TLS) MQTT on 1883. Convenient for AVR boards without TLS; prefer 8883.
MQTT_PLAIN_ENABLED=true

# --- Optional ----------------------------------------------------------------
LOG_LEVEL=info
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Backups -----------------------------------------------------------------
# Encrypts backups (at least 16 characters). Keep a copy somewhere safe: without it a backup
# can't be restored. It is never written into a backup.
BACKUP_PASSPHRASE=
# Also put MASTER_KEY in backups (only if where backups are kept is as trusted as this server).
BACKUP_INCLUDE_MASTER_KEY=false

# --- Storage (local disk by default) -----------------------------------------
STORAGE_DRIVER=local
# For S3 or S3-compatible storage (MinIO, Wasabi, DigitalOcean Spaces, Backblaze B2):
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AWS (see docs/aws.md) --------------------------------------------------------
# Device connectivity: emqx (bundled broker) or aws-iot (AWS IoT Core; adds docker-compose.aws.yml).
MQTT_TRANSPORT=emqx
AWS_REGION=
# Written by `cli aws-iot-setup` (install.sh --mqtt=aws-iot runs it).
AWS_IOT_ENDPOINT=
AWS_IOT_POLICY_NAME=perspice-device
# Leave empty on EC2, where the instance role provides credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Managed services instead of the bundled containers (RDS lacks TimescaleDB: use Timescale Cloud).
# DATABASE_URL=postgres://user:pass@host:5432/perspice
# REDIS_URL=rediss://master.example.cache.amazonaws.com:6379
