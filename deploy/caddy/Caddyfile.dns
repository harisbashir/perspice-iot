# Variant using a single wildcard certificate obtained with a DNS-01 challenge.
# Requires the custom image from Dockerfile.caddy and the provider's credentials, e.g.
#   CADDY_DNS_PROVIDER=cloudflare CLOUDFLARE_API_TOKEN=...
{
	email {$ACME_EMAIL}
}

(perspice) {
	import /etc/caddy/perspice.caddy
}

{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
	tls {
		dns {$CADDY_DNS_PROVIDER} {env.DNS_API_TOKEN}
	}
	import perspice
}

# Anything else over plain HTTP (the server's IP, say) is sent to the platform's address.
http:// {
	redir https://{$BASE_DOMAIN}{uri}
}

# Internal plain-HTTP listener for the PDF renderer (container network only; not published).
http://:8080 {
	import perspice
}
